[Unit]
Description=Reverb RSTZUSDT read-only Reality recorder (stz-q2-fy27)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/ubuntu/reverb/.env

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/reverb
EnvironmentFile=/home/ubuntu/reverb/.env
ExecStart=/home/ubuntu/reverb/.venv/bin/python scripts/costco_recorder.py --event stz-q2-fy27
Restart=no
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
