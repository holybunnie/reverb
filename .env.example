# Keep this file as a template. Store real values in a local environment only.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Optional language layer; never needed for pricing, risk, or order guards.
BITGET_QWEN_API_KEY=
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_MODEL=qwen3.6-plus

# Required only when enabling the calendar tool; no provider is silently chosen.
REVERB_EARNINGS_CALENDAR_URL=
# Required when the calendar supplies only a date, not a timestamp, e.g. 16:05.
REVERB_DEFAULT_EARNINGS_TIME_ET=
