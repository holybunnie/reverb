# Keep this file as a template. Store real values in a local environment only.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Optional read-only UTA key used only by Reality feed checks and the Costco recorder.
# When all three are set, those read-only workflows use this key; otherwise they use BITGET_*.
BITGET_READ_API_KEY=
BITGET_READ_SECRET_KEY=
BITGET_READ_PASSPHRASE=

# Optional local Agent Hub executable. Defaults to bgc; never put credentials here.
# REVERB_AGENT_HUB_BIN=/absolute/path/to/bgc

# Optional language layer; never needed for pricing, risk, or order guards.
QWEN_API_KEY=
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_MODEL=qwen3.8-max

# Edit config/calendar.json if you have a verified calendar source.
# The public source can return a date without a reporting time; set
# default_event_time_et there only when the event-time assumption is explicit.
